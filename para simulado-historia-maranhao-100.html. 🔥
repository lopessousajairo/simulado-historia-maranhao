<title>Simulado Final - História do Maranhão - 100 Questões</title>
<style>
:root{--bg:#07111f;--card:#0e1b2d;--card2:#12243a;--text:#f3f7fb;--muted:#9fb1c5;--accent:#43a5ff;--ok:#35c978;--bad:#ff5b67;--gold:#ffc857;--line:#213852}
*{box-sizing:border-box} body{margin:0;font-family:Inter,system-ui,-apple-system,Segoe UI,Roboto,Arial;background:linear-gradient(180deg,#06101d,#0a1626);color:var(--text);min-height:100vh}
.wrap{max-width:760px;margin:auto;padding:14px 14px 110px} .top{position:sticky;top:0;z-index:5;background:rgba(7,17,31,.93);backdrop-filter:blur(14px);padding:10px 0 12px;border-bottom:1px solid var(--line)}
h1{font-size:20px;margin:0 0 5px} .sub{font-size:12px;color:var(--muted)} .stats{display:grid;grid-template-columns:repeat(4,1fr);gap:7px;margin-top:10px}
.stat{background:var(--card);border:1px solid var(--line);border-radius:12px;padding:8px;text-align:center} .stat b{display:block;font-size:16px} .stat span{font-size:10px;color:var(--muted)}
.timer{margin-top:8px;display:flex;justify-content:space-between;align-items:center;background:#101f32;border:1px solid var(--line);padding:9px 11px;border-radius:12px;font-weight:700} #clock{font-variant-numeric:tabular-nums;color:var(--gold)}
.progress{height:7px;background:#14263b;border-radius:9px;overflow:hidden;margin:10px 0 0} #bar{height:100%;width:0;background:var(--accent);transition:.2s}
.card{margin-top:16px;background:var(--card);border:1px solid var(--line);border-radius:18px;padding:18px;box-shadow:0 10px 30px rgba(0,0,0,.18)}
.qnum{font-size:12px;color:var(--accent);font-weight:800;letter-spacing:.05em} .question{font-size:18px;line-height:1.45;margin:10px 0 16px;font-weight:650}
.answers{display:grid;grid-template-columns:1fr 1fr;gap:10px} button{font:inherit} .ans{padding:14px;border-radius:13px;border:1px solid #34506e;background:#13263d;color:#fff;font-weight:800;cursor:pointer}
.ans:hover{border-color:var(--accent)} .ans.correct{background:rgba(53,201,120,.16);border-color:var(--ok);color:#7ef0ae} .ans.wrong{background:rgba(255,91,103,.15);border-color:var(--bad);color:#ff9ca4}
.ans:disabled{cursor:default} .feedback{display:none;margin-top:14px;border-radius:12px;padding:12px;line-height:1.42;font-size:14px} .feedback.show{display:block} .feedback.ok{background:rgba(53,201,120,.1);border:1px solid rgba(53,201,120,.35)} .feedback.bad{background:rgba(255,91,103,.09);border:1px solid rgba(255,91,103,.35)}
.nav{display:flex;gap:8px;margin-top:15px} .nav button,.finish{flex:1;padding:12px;border-radius:12px;border:1px solid var(--line);background:var(--card2);color:#fff;font-weight:750;cursor:pointer}
.finish{background:#183b60;border-color:#2a6da5} .gridbtn{margin-top:10px;width:100%;padding:10px;border-radius:12px;background:transparent;color:var(--muted);border:1px solid var(--line)}
.palette{display:none;grid-template-columns:repeat(10,1fr);gap:5px;margin-top:10px} .palette.show{display:grid} .dot{aspect-ratio:1;border-radius:6px;border:1px solid var(--line);background:#102136;color:#9db0c5;font-size:10px} .dot.done{background:#1c4e37;color:#a6f1c2} .dot.current{outline:2px solid var(--accent)}
.bottom{position:fixed;bottom:0;left:0;right:0;background:rgba(7,17,31,.95);backdrop-filter:blur(12px);border-top:1px solid var(--line);padding:10px 14px;z-index:6} .bottomin{max-width:760px;margin:auto;display:flex;gap:8px}
.modal{display:none;position:fixed;inset:0;background:rgba(0,0,0,.72);z-index:20;padding:18px;overflow:auto} .modal.show{display:block} .result{max-width:700px;margin:25px auto;background:#0e1b2d;border:1px solid var(--line);border-radius:20px;padding:20px}
.result h2{margin-top:0} .big{font-size:40px;font-weight:900;color:var(--gold)} .rgrid{display:grid;grid-template-columns:repeat(2,1fr);gap:8px;margin:15px 0} .rbox{background:#13263d;border-radius:12px;padding:12px} .mistake{background:#101f32;border:1px solid #253f59;border-radius:12px;padding:12px;margin:8px 0;font-size:13px} .close{width:100%;padding:13px;border:0;border-radius:12px;background:var(--accent);color:white;font-weight:800}
.note{font-size:11px;color:var(--muted);margin-top:8px}
@media(max-width:480px){.wrap{padding-left:10px;padding-right:10px} .stats{gap:5px} .stat{padding:7px 4px} .question{font-size:17px} .palette{grid-template-columns:repeat(8,1fr)}}
</style>
</head>
<body>
<div class="wrap">
  <div class="top">
    <h1>🏛️ Revisão Final — História do Maranhão</h1>
    <div class="sub">100 itens • CEBRASPE • CERTO ou ERRADO</div>
    <div class="stats">
      <div class="stat"><b id="hits">0</b><span>ACERTOS</span></div>
      <div class="stat"><b id="miss">0</b><span>ERROS</span></div>
      <div class="stat"><b id="pct">0%</b><span>APROVEIT.</span></div>
      <div class="stat"><b id="score">0</b><span>SALDO CEBRASPE</span></div>
    </div>
