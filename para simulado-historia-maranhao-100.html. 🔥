  </div>

  <div class="card">
    <div class="qnum" id="qnum"></div>
    <div class="question" id="qtext"></div>
    <div class="answers">
      <button class="ans" id="cbtn" onclick="answer('C')">✓ CERTO</button>
      <button class="ans" id="ebtn" onclick="answer('E')">✕ ERRADO</button>
    </div>
    <div id="feedback" class="feedback"></div>
    <div class="nav">
      <button onclick="prev()">← Anterior</button>
      <button onclick="next()">Próxima →</button>
    </div>
    <button class="gridbtn" onclick="togglePalette()">☷ Ver mapa das 100 questões</button>
    <div class="palette" id="palette"></div>
    <div class="note">Pontuação CEBRASPE exibida como acertos − erros. O cronômetro para ao finalizar a prova.</div>
  </div>
</div>

<div class="bottom"><div class="bottomin">
  <button class="finish" onclick="finishExam()">🏁 FINALIZAR SIMULADO</button>
</div></div>

<div class="modal" id="modal"><div class="result">
  <h2>Resultado final</h2>
  <div class="big" id="finalPct">0%</div>
  <div class="rgrid">
    <div class="rbox"><b id="finalHits">0</b><br><small>Acertos</small></div>
    <div class="rbox"><b id="finalMiss">0</b><br><small>Erros</small></div>
    <div class="rbox"><b id="finalBlank">0</b><br><small>Em branco</small></div>
    <div class="rbox"><b id="finalTime">00:00:00</b><br><small>Tempo total</small></div>
  </div>
  <p><b>Saldo CEBRASPE:</b> <span id="finalScore"></span> pontos (acertos − erros).</p>
  <h3>Revisão dos erros</h3>
  <div id="mistakes"></div>
  <button class="close" onclick="document.getElementById('modal').classList.remove('show')">Voltar ao simulado</button>
</div></div>

<script>
const Q = [{"n": 1, "text": "A França Equinocial foi uma tentativa francesa de colonização no norte da América Portuguesa, tendo São Luís como núcleo principal.", "answer": "C", "explanation": "A França Equinocial foi instalada pelos franceses no Maranhão em 1612, com centro em São Luís."}, {"n": 2, "text": "Daniel de La Touche, senhor de La Ravardière, esteve ligado à expedição francesa que fundou São Luís em 1612.", "answer": "C", "explanation": "La Ravardière foi uma das principais figuras da ocupação francesa e da fundação de São Luís."}, {"n": 3, "text": "São Luís recebeu esse nome em homenagem ao rei francês Luís XIII.", "answer": "C", "explanation": "A denominação remete ao monarca francês Luís XIII."}, {"n": 4, "text": "A fundação de São Luís pelos franceses ocorreu em 1615, após a Batalha de Guaxenduba.", "answer": "E", "explanation": "São Luís foi fundada em 1612; Guaxenduba ocorreu em 1614 e a expulsão definitiva dos franceses em 1615."}, {"n": 5, "text": "A presença francesa no Maranhão foi totalmente desprovida de alianças com povos indígenas.", "answer": "E", "explanation": "Os franceses estabeleceram alianças com grupos indígenas, elemento importante de sua presença na região."}, {"n": 6, "text": "A chamada França Equinocial deve ser distinguida da França Antártica, tentativa francesa ocorrida anteriormente na região da baía de Guanabara.", "answer": "C", "explanation": "França Antártica relaciona-se ao Rio de Janeiro; França Equinocial, ao Maranhão."}, {"n": 7, "text": "A Batalha de Guaxenduba ocorreu em 1614, no contexto da disputa entre portugueses e franceses pelo Maranhão.", "answer": "C", "explanation": "Guaxenduba foi um confronto decisivo de 1614."}, {"n": 8, "text": "Jerônimo de Albuquerque participou do esforço português contra os franceses no Maranhão.", "answer": "C", "explanation": "Ele comandou forças portuguesas no confronto contra a presença francesa."}, {"n": 9, "text": "A vitória portuguesa em Guaxenduba significou a expulsão imediata e definitiva dos franceses ainda em 1614.", "answer": "E", "explanation": "A batalha foi decisiva, mas a expulsão definitiva ocorreu em 1615."}, {"n": 10, "text": "A expulsão dos franceses do Maranhão consolidou-se em 1615.", "answer": "C", "explanation": "Em 1615, os portugueses consolidaram o domínio sobre São Luís."}, {"n": 11, "text": "Alexandre de Moura integrou a ofensiva portuguesa que culminou na retirada francesa do Maranhão.", "answer": "C", "explanation": "Sua atuação esteve ligada à etapa final da expulsão francesa."}, {"n": 12, "text": "A França Equinocial foi organizada pelos holandeses para controlar o comércio açucareiro maranhense.", "answer": "E", "explanation": "Foi uma iniciativa francesa, não holandesa."}, {"n": 13, "text": "A localização de São Luís possuía importância estratégica para o controle do litoral setentrional.", "answer": "C", "explanation": "A posição geográfica favorecia defesa, navegação e controle regional."}, {"n": 14, "text": "A ocupação francesa do Maranhão ocorreu durante o período da União Ibérica.", "answer": "C", "explanation": "Em 1612, Portugal estava sob a mesma Coroa dos Habsburgo espanhóis."}, {"n": 15, "text": "Por estar sob a União Ibérica, a reação aos franceses no Maranhão ocorreu em um contexto no qual Portugal e Espanha estavam sob o mesmo monarca.", "answer": "C", "explanation": "A União Ibérica durou de 1580 a 1640."}, {"n": 16, "text": "A Batalha de Guaxenduba foi travada entre portugueses e holandeses.", "answer": "E", "explanation": "Guaxenduba opôs principalmente portugueses e franceses."}, {"n": 17, "text": "O Forte de Santa Maria esteve ligado à preparação portuguesa na região de Guaxenduba.", "answer": "C", "explanation": "As forças portuguesas construíram fortificação na área antes do confronto."}, {"n": 18, "text": "A expressão 'Jornada Milagrosa' é associada, em narrativas históricas, à vitória portuguesa em Guaxenduba.", "answer": "C", "explanation": "A batalha ficou tradicionalmente associada a essa denominação."}, {"n": 19, "text": "Depois de 1615, São Luís permaneceu politicamente sob domínio francês por várias décadas.", "answer": "E", "explanation": "Após a retirada francesa, consolidou-se o domínio português."}, {"n": 20, "text": "A história inicial de São Luís envolve, sucessivamente, presença francesa, domínio português e, posteriormente, ocupação holandesa.", "answer": "C", "explanation": "Esses três momentos aparecem na trajetória colonial da cidade."}, {"n": 21, "text": "Os holandeses ocuparam São Luís em 1641.", "answer": "C", "explanation": "A ocupação holandesa de São Luís iniciou-se em 1641."}, {"n": 22, "text": "A ocupação holandesa no Maranhão ocorreu de forma permanente e só terminou com a Independência do Brasil.", "answer": "E", "explanation": "A presença holandesa foi encerrada ainda no século XVII."}, {"n": 23, "text": "Os holandeses foram expulsos do Maranhão em 1644.", "answer": "C", "explanation": "A resistência luso-brasileira levou à expulsão em 1644."}, {"n": 24, "text": "A ocupação holandesa do Maranhão pode ser compreendida no contexto mais amplo da presença neerlandesa no Nordeste do Brasil.", "answer": "C", "explanation": "Ela se relaciona às disputas atlânticas e à expansão neerlandesa no Brasil colonial."}, {"n": 25, "text": "A ocupação holandesa de São Luís começou antes da expulsão dos franceses.", "answer": "E", "explanation": "Franceses foram expulsos em 1615; holandeses chegaram em 1641."}, {"n": 26, "text": "A resistência contra os holandeses no Maranhão demonstrou que a ocupação não foi simplesmente aceita de forma pacífica.", "answer": "C", "explanation": "Houve resistência e conflito até a expulsão dos holandeses."}, {"n": 27, "text": "A criação de uma administração separada para o norte da América Portuguesa esteve ligada às dificuldades de comunicação com o Estado do Brasil.", "answer": "C", "explanation": "Distâncias e rotas marítimas favoreceram uma administração própria para o norte."}, {"n": 28, "text": "O Estado do Maranhão surgiu como unidade administrativa distinta do Estado do Brasil durante o período colonial.", "answer": "C", "explanation": "A Coroa organizou administrativamente o norte de forma separada em diferentes momentos."}, {"n": 29, "text": "A administração do Estado do Maranhão era sempre subordinada diretamente ao governo instalado em Salvador, sem comunicação própria com Lisboa.", "answer": "E", "explanation": "A administração setentrional teve relação direta com a Coroa e autonomia administrativa relativa frente ao Estado do Brasil."}, {"n": 30, "text": "A organização administrativa do Maranhão e Grão-Pará sofreu alterações ao longo do período colonial.", "answer": "C", "explanation": "Nomes, sedes e delimitações administrativas mudaram ao longo do tempo."}, {"n": 31, "text": "A existência do Estado do Maranhão e Grão-Pará evidencia que a América Portuguesa nem sempre foi administrada como uma unidade única.", "answer": "C", "explanation": "Houve distintas unidades administrativas no território colonial."}, {"n": 32, "text": "A ocupação do Maranhão no século XVII estava associada também à preocupação portuguesa com invasões estrangeiras no litoral norte.", "answer": "C", "explanation": "A presença francesa e outras ameaças estimularam a ocupação e defesa do território."}, {"n": 33, "text": "São Luís jamais sofreu ocupação estrangeira depois da retirada francesa.", "answer": "E", "explanation": "A cidade foi ocupada pelos holandeses em 1641."}, {"n": 34, "text": "A expulsão holandesa do Maranhão ocorreu aproximadamente três décadas após a expulsão francesa.", "answer": "C", "explanation": "1615 para 1644: diferença de 29 anos."}, {"n": 35, "text": "Franceses e holandeses ocuparam São Luís no mesmo século.", "answer": "C", "explanation": "Ambos os episódios ocorreram no século XVII."}, {"n": 36, "text": "A Revolta de Beckman ocorreu em São Luís, em 1684.", "answer": "C", "explanation": "A revolta eclodiu em 1684, no Maranhão."}, {"n": 37, "text": "A Revolta de Beckman foi liderada, entre outros, por Manuel Beckman.", "answer": "C", "explanation": "Manuel Beckman foi uma das principais lideranças do movimento."}, {"n": 38, "text": "Tomás Beckman foi enviado a Portugal para apresentar reivindicações dos revoltosos.", "answer": "C", "explanation": "Ele procurou levar as demandas do movimento à Corte."}, {"n": 39, "text": "A Revolta de Beckman possuía como alvo de insatisfação a Companhia de Comércio do Maranhão.", "answer": "C", "explanation": "O monopólio e o funcionamento da Companhia estavam entre as principais causas da revolta."}, {"n": 40, "text": "A Companhia de Comércio foi criticada por problemas no fornecimento de mão de obra africana escravizada e por seu monopólio comercial.", "answer": "C", "explanation": "Essas insatisfações contribuíram para a revolta."}, {"n": 41, "text": "Os jesuítas também foram alvo dos revoltosos, em razão de conflitos relacionados à utilização da mão de obra indígena.", "answer": "C", "explanation": "Os colonos se chocavam com os jesuítas sobre a escravização e controle da mão de obra indígena."}, {"n": 42, "text": "A Revolta de Beckman defendia explicitamente a independência do Maranhão em relação a Portugal e a implantação de uma república.", "answer": "E", "explanation": "Foi uma revolta colonial de caráter local/nativista, não um movimento separatista republicano."}, {"n": 43, "text": "Por seu caráter nativista, a Revolta de Beckman questionava práticas da administração colonial sem propor necessariamente a ruptura com a monarquia portuguesa.", "answer": "C", "explanation": "Essa é uma distinção central para provas."}, {"n": 44, "text": "A Revolta de Beckman ocorreu no século XVIII, durante o ciclo do ouro.", "answer": "E", "explanation": "Ocorreu em 1684, século XVII."}, {"n": 45, "text": "A Coroa portuguesa reprimiu a Revolta de Beckman.", "answer": "C", "explanation": "O movimento foi debelado pelas autoridades portuguesas."}, {"n": 46, "text": "Manuel Beckman foi condenado à morte após a repressão ao movimento.", "answer": "C", "explanation": "Ele foi executado após a derrota da revolta."}, {"n": 47, "text": "A Revolta de Beckman teve como causa exclusiva a cobrança da derrama sobre o ouro.", "answer": "E", "explanation": "A derrama se relaciona a outro contexto; Beckman envolveu monopólio comercial, mão de obra e jesuítas."}, {"n": 48, "text": "Os revoltosos chegaram a expulsar jesuítas e a atacar a estrutura da Companhia de Comércio.", "answer": "C", "explanation": "Essas ações integraram o movimento."}, {"n": 49, "text": "A Revolta de Beckman é considerada um dos movimentos nativistas do período colonial.", "answer": "C", "explanation": "É tradicionalmente classificada entre as revoltas nativistas."}, {"n": 50, "text": "O termo 'nativista', aplicado à Revolta de Beckman, significa que o movimento já defendia uma identidade nacional brasileira plenamente consolidada.", "answer": "E", "explanation": "Nativismo não equivale automaticamente a nacionalismo independentista."}, {"n": 51, "text": "Problemas de abastecimento e preços praticados no comércio local contribuíram para a insatisfação no Maranhão no período da Revolta de Beckman.", "answer": "C", "explanation": "O funcionamento do monopólio afetava preços e abastecimento."}, {"n": 52, "text": "A economia colonial maranhense esteve ligada, em diferentes períodos, à agricultura de exportação e ao trabalho escravizado.", "answer": "C", "explanation": "Produções agrícolas e trabalho compulsório tiveram grande importância econômica."}, {"n": 53, "text": "O algodão ganhou importância econômica no Maranhão, sobretudo em contexto posterior ao século XVII.", "answer": "C", "explanation": "A lavoura algodoeira tornou-se importante especialmente no século XVIII."}, {"n": 54, "text": "A Revolta de Beckman ocorreu antes da Inconfidência Mineira.", "answer": "C", "explanation": "Beckman: 1684; Inconfidência: 1789."}, {"n": 55, "text": "A Revolta de Beckman e a Balaiada pertencem ao mesmo período histórico, ambas ocorrendo durante a Regência.", "answer": "E", "explanation": "Beckman é colonial; Balaiada é regencial, no século XIX."}, {"n": 56, "text": "A adesão do Maranhão à Independência do Brasil não ocorreu imediatamente em 7 de setembro de 1822.", "answer": "C", "explanation": "A adesão de São Luís foi oficializada somente em julho de 1823."}, {"n": 57, "text": "São Luís oficializou a adesão do Maranhão ao Império do Brasil em 28 de julho de 1823.", "answer": "C", "explanation": "A Câmara Geral proclamou a adesão em 28 de julho de 1823."}, {"n": 58, "text": "A forte ligação comercial e política de setores da elite maranhense com Portugal ajuda a explicar resistências à Independência.", "answer": "C", "explanation": "Esses vínculos favoreceram a manutenção da fidelidade a Lisboa por parte de grupos locais."}, {"n": 59, "text": "A Independência no Maranhão ocorreu sem tensões militares ou disputas entre grupos favoráveis e contrários à separação de Portugal.", "answer": "E", "explanation": "O processo foi conflituoso e envolveu mobilização armada."}, {"n": 60, "text": "Lorde Cochrane teve participação importante na adesão de São Luís à Independência.", "answer": "C", "explanation": "A chegada de Cochrane por mar pressionou a capitulação da capital."}, {"n": 61, "text": "Cochrane comandava forças ligadas ao Império do Brasil.", "answer": "C", "explanation": "Ele atuava como primeiro almirante da Armada do Brasil."}, {"n": 62, "text": "A pressão naval exercida por Cochrane sobre São Luís contribuiu para a capitulação dos setores portugueses.", "answer": "C", "explanation": "O controle do acesso marítimo foi decisivo."}, {"n": 63, "text": "A adesão do Maranhão em 1823 demonstra que a Independência do Brasil foi um processo regionalmente desigual.", "answer": "C", "explanation": "Diversas províncias aderiram em momentos e condições diferentes."}, {"n": 64, "text": "João José da Cunha Fidié esteve associado à resistência portuguesa contra a causa da Independência na região do Piauí e do Maranhão.", "answer": "C", "explanation": "Fidié comandou forças fiéis a Portugal e sua atuação alcançou a região."}, {"n": 65, "text": "Fidié era comandante das tropas brasileiras enviadas por D. Pedro I para expulsar os portugueses do Maranhão.", "answer": "E", "explanation": "Fidié estava ligado às forças leais a Portugal."}, {"n": 66, "text": "A Batalha do Jenipapo ocorreu em 1823, no Piauí.", "answer": "C", "explanation": "A batalha ocorreu em 13 de março de 1823, em Campo Maior, Piauí."}, {"n": 67, "text": "Embora tenha ocorrido no Piauí, a Batalha do Jenipapo integra o contexto das lutas pela Independência que repercutiram no Maranhão.", "answer": "C", "explanation": "Os conflitos no Piauí, Ceará e Maranhão eram regionalmente conectados."}, {"n": 68, "text": "A Batalha do Jenipapo foi uma vitória militar completa das forças populares, que capturaram imediatamente Fidié.", "answer": "E", "explanation": "As forças de Fidié venceram militarmente o combate, embora o episódio tenha grande importância política e simbólica para a Independência."}, {"n": 69, "text": "Após os conflitos no Piauí, Fidié deslocou-se em direção a Caxias, no Maranhão.", "answer": "C", "explanation": "Caxias tornou-se ponto central da resistência de Fidié."}, {"n": 70, "text": "Caxias teve papel importante nas lutas pela adesão do Maranhão à Independência.", "answer": "C", "explanation": "A região foi palco de confrontos e da resistência portuguesa."}, {"n": 71, "text": "A rendição de Fidié em Caxias ocorreu no contexto do avanço das forças favoráveis à Independência.", "answer": "C", "explanation": "O cerco e a pressão sobre Caxias levaram à rendição."}, {"n": 72, "text": "A capitulação de São Luís precedeu a atuação de Cochrane na região.", "answer": "E", "explanation": "A presença e pressão de Cochrane contribuíram diretamente para a capitulação."}, {"n": 73, "text": "A adesão do Maranhão foi apenas uma formalidade administrativa, sem participação de forças vindas do Piauí ou do Ceará.", "answer": "E", "explanation": "Forças e movimentos regionais do Piauí e Ceará tiveram papel no processo."}, {"n": 74, "text": "O fato de o Maranhão ter aderido em 1823 permite concluir que a província permaneceu independente tanto de Portugal quanto do Império até 1824.", "answer": "E", "explanation": "O Maranhão estava em disputa; a adesão foi ao Império do Brasil."}, {"n": 75, "text": "Em prova, é incorreto igualar automaticamente '7 de setembro de 1822' à data de adesão de todas as províncias brasileiras.", "answer": "C", "explanation": "A Independência foi um processo; várias províncias tiveram cronologias próprias."}, {"n": 76, "text": "A Balaiada ocorreu durante o Período Regencial.", "answer": "C", "explanation": "A revolta iniciou-se em 1838 e desenvolveu-se no contexto regencial."}, {"n": 77, "text": "A Balaiada teve forte presença no Maranhão e alcançou também áreas do Piauí.", "answer": "C", "explanation": "O movimento ultrapassou limites provinciais."}, {"n": 78, "text": "Raimundo Gomes é uma das lideranças associadas à Balaiada.", "answer": "C", "explanation": "Raimundo Gomes teve papel importante no início e desenvolvimento do movimento."}, {"n": 79, "text": "Manuel Francisco dos Anjos Ferreira, conhecido como Balaio, deu nome à Balaiada.", "answer": "C", "explanation": "O apelido 'Balaio' está na origem da denominação do movimento."}, {"n": 80, "text": "Cosme Bento, conhecido como Negro Cosme, liderou numeroso contingente de escravizados e libertos no contexto da Balaiada.", "answer": "C", "explanation": "Negro Cosme foi liderança central entre negros escravizados e libertos."}, {"n": 81, "text": "A Balaiada foi um movimento social homogêneo, composto exclusivamente por grandes proprietários rurais.", "answer": "E", "explanation": "Reuniu grupos sociais diversos, com expressiva participação popular."}, {"n": 82, "text": "Conflitos entre grupos políticos locais contribuíram para o contexto da Balaiada.", "answer": "C", "explanation": "Disputas entre liberais e conservadores locais se combinaram com tensões sociais."}, {"n": 83, "text": "A crise econômica maranhense, incluindo dificuldades relacionadas ao algodão, compôs o cenário da Balaiada.", "answer": "C", "explanation": "A conjuntura econômica agravou tensões sociais."}, {"n": 84, "text": "A Balaiada pode ser explicada exclusivamente como uma revolta de escravizados, sem participação de sertanejos livres.", "answer": "E", "explanation": "Participaram vaqueiros, sertanejos, artesãos, escravizados e outros grupos."}, {"n": 85, "text": "O movimento balaío teve caráter popular mais amplo que uma simples disputa entre facções da elite.", "answer": "C", "explanation": "As disputas políticas foram importantes, mas o movimento ganhou ampla dimensão social."}, {"n": 86, "text": "Luís Alves de Lima e Silva foi enviado para combater a Balaiada.", "answer": "C", "explanation": "O futuro Duque de Caxias comandou a repressão ao movimento."}, {"n": 87, "text": "A atuação de Luís Alves de Lima e Silva na repressão à Balaiada contribuiu para sua projeção política e militar.", "answer": "C", "explanation": "A campanha no Maranhão foi importante em sua trajetória."}, {"n": 88, "text": "A Balaiada terminou com a proclamação de uma república independente no Maranhão.", "answer": "E", "explanation": "O movimento foi reprimido pelas forças imperiais."}, {"n": 89, "text": "A Balaiada e a Cabanagem são revoltas regenciais distintas, ocorridas em regiões diferentes.", "answer": "C", "explanation": "Balaiada: sobretudo Maranhão/Piauí; Cabanagem: Pará."}, {"n": 90, "text": "A Balaiada ocorreu antes da adesão do Maranhão à Independência.", "answer": "E", "explanation": "Adesão: 1823; Balaiada: 1838-1841."}, {"n": 91, "text": "O nome 'Balaiada' deriva diretamente de Raimundo Gomes, cuja profissão era fabricante de balaios.", "answer": "E", "explanation": "A denominação relaciona-se a Manuel Francisco dos Anjos Ferreira, o Balaio."}, {"n": 92, "text": "Negro 