let idx=0, answers=Array(Q.length).fill(null), start=Date.now(), stopped=false, finalElapsed=0;

function fmt(ms){let s=Math.floor(ms/1000),h=Math.floor(s/3600);s%=3600;let m=Math.floor(s/60);s%=60;return [h,m,s].map(x=>String(x).padStart(2,'0')).join(':')}
setInterval(()=>{if(!stopped) document.getElementById('clock').textContent=fmt(Date.now()-start)},1000);

function render(){
 const q=Q[idx]; qnum.textContent=`QUESTÃO ${q.n} DE 100`; qtext.textContent=q.text;
 const fb=document.getElementById('feedback'), c=document.getElementById('cbtn'), e=document.getElementById('ebtn');
 [c,e].forEach(b=>{b.className='ans'; b.disabled=false});
 fb.className='feedback'; fb.innerHTML='';
 if(answers[idx]){
   c.disabled=e.disabled=true;
   let chosen=answers[idx], ok=chosen===q.answer;
   (chosen==='C'?c:e).classList.add(ok?'correct':'wrong');
   (q.answer==='C'?c:e).classList.add('correct');
   fb.className='feedback show '+(ok?'ok':'bad');
   fb.innerHTML=`<b>${ok?'✅ ACERTOU':'❌ ERROU'} — Gabarito: ${q.answer==='C'?'CERTO':'ERRADO'}</b><br>${q.explanation}`;
 }
 update(); buildPalette();
}
function answer(a){if(answers[idx]||stopped)return;answers[idx]=a;render()}
function prev(){if(idx>0){idx--;render()}} function next(){if(idx<Q.length-1){idx++;render()}}
function update(){
 let hit=0,miss=0,done=0; answers.forEach((a,i)=>{if(a){done++; if(a===Q[i].answer)hit++;else miss++}});
 hits.textContent=hit; document.getElementById('miss').textContent=miss;
 pct.textContent=done?Math.round(hit/done*100)+'%':'0%'; score.textContent=hit-miss;
 bar.style.width=(done/Q.length*100)+'%';
}
function buildPalette(){
 let p=document.getElementById('palette'); p.innerHTML='';
 Q.forEach((q,i)=>{let b=document.createElement('button'); b.className='dot '+(answers[i]?'done ':'')+(i===idx?'current':''); b.textContent=i+1;b.onclick=()=>{idx=i;render()};p.appendChild(b)})
}
function togglePalette(){document.getElementById('palette').classList.toggle('show')}
function finishExam(){
 if(!stopped){stopped=true;finalElapsed=Date.now()-start;document.getElementById('clock').textContent=fmt(finalElapsed)}
 let hit=0,miss=0,blank=0, mistakes=[];
 answers.forEach((a,i)=>{if(!a)blank++;else if(a===Q[i].answer)hit++;else{miss++;mistakes.push(i)}});
 finalHits.textContent=hit; finalMiss.textContent=miss; finalBlank.textContent=blank; finalTime.textContent=fmt(finalElapsed);
 finalPct.textContent=Math.round(hit/Q.length*100)+'%'; finalScore.textContent=hit-miss;
 let m=document.getElementById('mistakes');
 m.innerHTML=mistakes.length?mistakes.map(i=>`<div class="mistake"><b>Q${i+1} — Você marcou ${answers[i]==='C'?'CERTO':'ERRADO'} | Gabarito: ${Q[i].answer==='C'?'CERTO':'ERRADO'}</b><br>${Q[i].text}<br><span style="color:#9fb1c5">${Q[i].explanation}</span></div>`).join(''):'<p>🏆 Nenhum erro. Excelente revisão!</p>';
 document.getElementById('modal').classList.add('show');
}
render();
</script>
